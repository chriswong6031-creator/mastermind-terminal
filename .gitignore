# secrets + local config
.env
config/charting.yml

# python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# node (indicator_engine sidecar, Phase 1)
node_modules/

# box (VPS) runtime caches + in-place backups — live only on the box; never commit
# (a committed stale copy would clobber the newer box file via the deploy overlay)
ingest/hk_universe_cache.json
ingest/zh_cache.json
ingest/.polygon_*.json
*.bak-*

# data — caches and generated sidecars are not committed; samples ARE (see below)
data/cache/
data/backtests/*.parquet
data/publish_staging/

# generated chart OHLC (regenerate via ingest/sample_from_macro.py)
web/ohlc/*.json

# keep the worked contract samples tracked (they document the contract)
!contracts/samples/*.json

.DS_Store
