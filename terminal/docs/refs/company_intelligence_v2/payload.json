     "text_sha256": "94426e0142792f132c7c1432fe5a5a3d4029f141efe82ded236093b94443aea6",
     "text": "Total revenue was $171.1 billion for the quarter",
     "claim_id": "revenue",
     "inside_committed_span": false
    },
    {
     "segment_index": 2,
     "paragraph": 3,
     "speaker": "Miren Okafor",
