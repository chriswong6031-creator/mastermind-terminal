     "text_sha256": "07ff6f1a8acf70017ac406669fdf0e14f18c66a551dba2d8b9611801915b00fe",
     "text": "non-GAAP diluted earnings per share were $11.46",
     "claim_id": "eps",
     "inside_committed_span": false
    },
    {
     "segment_index": 2,
     "paragraph": 3,
     "speaker": "Miren Okafor",
