   "committed_receipt_verified": true,
   "segments": [
    {
     "speaker": "Operator",
     "role": "Operator",
     "text": "Good afternoon and welcome to the The Boeing Company Q2 2024 earnings conference call. All participants will be in listen-only mode. Please note this event is being recorded."
    },
    {
     "speaker": "Dana Whitfield",
     "role": "Chief Executive Officer",
     "text": "The Boeing Company closed Q2 2024 with demand broadly in line with the plan we laid out ninety days ago, and we exited the quarter with the cost base we committed to."
    },
    {
     "speaker": "Miren Okafor",
     "role": "Chief Financial Officer",
     "text": "Total revenue was $171.1 billion for the quarter, and non-GAAP diluted earnings per share were $11.46. Operating margin finished at 40.0%. We are guiding next quarter to a range of $157.4 billion to $163.7 billion."
    },
    {
     "speaker": "Priya Raghunathan",
     "role": "Analyst, Ridgeline Research",
     "text": "Thanks for taking the question. Can you walk through how much of the 40.0% move is mix versus pricing, and whether you expect the same input costs to carry into next quarter?"
    }
   ],
   "committed_receipt_text": "We are guiding next quarter to a range of $157.4 billion to $163.7 billion."
  },
