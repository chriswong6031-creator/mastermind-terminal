     "span_start_byte": 139,
     "span_end_byte": 214,
     "segment_sha256": "2c0f630ffc1dfd70e7416f98daea06b826701354a84d5bc39dc2142b054e50e7",
     "text_sha256": "3b933268649b0d2fc798a1e14d3e6151bdf950766c2b4ae28772b333579cde53",
     "text": "We are guiding next quarter to a range of $157.4 billion to $163.7 billion.",
