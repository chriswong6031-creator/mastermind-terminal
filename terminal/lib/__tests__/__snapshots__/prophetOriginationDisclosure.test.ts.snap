exports[`SignalCard without origination fields renders exactly as before > is byte-identical to the pre-disclosure card in Chinese 1`] = `"<div class="obs-card obs-prophet-signal" style="position:relative;padding:12px 13px;cursor:pointer;margin-bottom:8px;opacity:1" role="option" aria-selected="false"><div style="display:flex;align-items:center;flex-wrap:wrap;gap:5px"><span style="font:750 15px/1 var(--font-ui);color:var(--text);letter-spacing:.01em">UBER</span><span class="obs-tag" style="font-size:10px;font-weight:700;padding:3px 8px;gap:3px;--c:var(--up)">▲ 做多</span><span class="obs-tag" style="font-size:10px;font-weight:600;padding:3px 8px;gap:3px;--c:var(--brand-2)">Recovery</span><div style="flex:1"></div><span class="obs-tag" style="font-size:9px;font-weight:600;padding:3px 8px;gap:3px;--c:var(--muted)">触发前</span></div><div style="display:flex;align-items:center;flex-wrap:wrap;gap:12px;margin-top:6px;font-size:10.5px"><span style="display:flex;flex-direction:column;gap:2px"><span class="obs-lbl" style="font:500 9px/1 var(--font-ui);color:var(--muted)">入场价</span><span class="num" style="font:600 11px/1 var(--font-num);font-variant-numeric:tabular-nums;color:var(--text)">$74.43</span></span><span style="display:flex;flex-direction:column;gap:2px"><span style="font:500 9px/1 var(--font-ui);color:var(--muted)"></span><span class="num" style="font:600 11px/1 var(--font-num);font-variant-numeric:tabular-nums;color:var(--muted)">48天活跃</span></span><span class="num" style="margin-left:auto;font:600 11px/1 var(--font-num);font-variant-numeric:tabular-nums;color:var(--up)">+4.9%<span style="font:500 9px/1 var(--font-ui);color:var(--muted);margin-left:3px">较计划</span></span></div><div style="margin-top:7px"><div style="display:flex;justify-content:space-between;margin-bottom:3px"><span class="num" style="font:500 9.5px/1 var(--font-ui);font-variant-numeric:tabular-nums;color:var(--muted)">31% → T1</span></div><div style="height:4px;background:var(--line-2);border-radius:var(--r-pill);overflow:hidden"><div style="height:100%;width:31.049069373942384%;background:var(--up);border-radius:var(--r-pill);transition:width .3s"></div></div></div><div style="margin-top:5px"><div style="display:flex;justify-content:space-between;margin-bottom:3px;align-items:center"><span class="num" style="font:500 9.5px/1 var(--font-ui);font-variant-numeric:tabular-nums;color:var(--muted)">48d / 10d 最短持有</span><span style="font:600 9px/1 var(--font-ui);color:var(--up)">可退出</span></div><div style="height:4px;background:var(--line-2);border-radius:var(--r-pill);overflow:hidden"><div style="height:100%;width:100%;background:var(--up);border-radius:var(--r-pill);transition:width .3s"></div></div></div></div>"`;

exports[`SignalCard without origination fields renders exactly as before > is byte-identical to the pre-disclosure card in English 1`] = `"<div class="obs-card obs-prophet-signal" style="position:relative;padding:12px 13px;cursor:pointer;margin-bottom:8px;opacity:1" role="option" aria-selected="false"><div style="display:flex;align-items:center;flex-wrap:wrap;gap:5px"><span style="font:750 15px/1 var(--font-ui);color:var(--text);letter-spacing:.01em">UBER</span><span class="obs-tag" style="font-size:10px;font-weight:700;padding:3px 8px;gap:3px;--c:var(--up)">▲ BULL</span><span class="obs-tag" style="font-size:10px;font-weight:600;padding:3px 8px;gap:3px;--c:var(--brand-2)">Recovery</span><div style="flex:1"></div><span class="obs-tag" style="font-size:9px;font-weight:600;padding:3px 8px;gap:3px;--c:var(--muted)">Pre-Trigger</span></div><div style="display:flex;align-items:center;flex-wrap:wrap;gap:12px;margin-top:6px;font-size:10.5px"><span style="display:flex;flex-direction:column;gap:2px"><span class="obs-lbl" style="font:500 9px/1 var(--font-ui);color:var(--muted)">Entry</span><span class="num" style="font:600 11px/1 var(--font-num);font-variant-numeric:tabular-nums;color:var(--text)">$74.43</span></span><span style="display:flex;flex-direction:column;gap:2px"><span style="font:500 9px/1 var(--font-ui);color:var(--muted)"></span><span class="num" style="font:600 11px/1 var(--font-num);font-variant-numeric:tabular-nums;color:var(--muted)">48d active</span></span><span class="num" style="margin-left:auto;font:600 11px/1 var(--font-num);font-variant-numeric:tabular-nums;color:var(--up)">+4.9%<span style="font:500 9px/1 var(--font-ui);color:var(--muted);margin-left:3px">vs plan</span></span></div><div style="margin-top:7px"><div style="display:flex;justify-content:space-between;margin-bottom:3px"><span class="num" style="font:500 9.5px/1 var(--font-ui);font-variant-numeric:tabular-nums;color:var(--muted)">31% → T1</span></div><div style="height:4px;background:var(--line-2);border-radius:var(--r-pill);overflow:hidden"><div style="height:100%;width:31.049069373942384%;background:var(--up);border-radius:var(--r-pill);transition:width .3s"></div></div></div><div style="margin-top:5px"><div style="display:flex;justify-content:space-between;margin-bottom:3px;align-items:center"><span class="num" style="font:500 9.5px/1 var(--font-ui);font-variant-numeric:tabular-nums;color:var(--muted)">48d / 10d min hold</span><span style="font:600 9px/1 var(--font-ui);color:var(--up)">ELIGIBLE</span></div><div style="height:4px;background:var(--line-2);border-radius:var(--r-pill);overflow:hidden"><div style="height:100%;width:100%;background:var(--up);border-radius:var(--r-pill);transition:width .3s"></div></div></div></div>"`;
